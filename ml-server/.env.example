# ── ML Service ────────────────────────────────────────────────────────────────
ML_HOST=0.0.0.0
ML_PORT=8000

# ── Node.js backend (for dynamic Gemini key resolution) ──────────────────────
NODE_SERVER_URL=http://localhost:4000

# ── Shared secret (must match server/.env INTERNAL_SERVICE_SECRET) ────────────
INTERNAL_SERVICE_SECRET=your_internal_secret_here

# ── Gemini AI (fallback if Node key service is unavailable) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY_TTL=30

# ── Whisper ASR ───────────────────────────────────────────────────────────────
WHISPER_MODEL=tiny.en
CHUNK_DURATION_SEC=15
MIN_WORDS_FOR_SCORE=50

# ── CRNN filler model ─────────────────────────────────────────────────────────
# Default: ml-server/models/filler_crnn_final.pth
# FILLER_MODEL_PATH=/absolute/path/to/filler_crnn_final.pth

# ── Sentence-transformers ─────────────────────────────────────────────────────
SBERT_MODEL=all-MiniLM-L6-v2

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
ML_CORS_ORIGINS=http://localhost:4000,http://localhost:5000,http://localhost:5173,http://localhost:5174

# ── HTTP timeouts (seconds) ───────────────────────────────────────────────────
HTTP_TIMEOUT_NODE=5
HTTP_TIMEOUT_GEMINI=30

# ── Retry ─────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_SEC=1.0
