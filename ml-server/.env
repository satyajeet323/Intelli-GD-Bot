ML_HOST=0.0.0.0
ML_PORT=8000

# Node.js backend — must be listed so Node→ML HTTP calls are accepted
NODE_SERVER_URL=http://localhost:4000

# Shared secret — must match server/.env INTERNAL_SERVICE_SECRET
INTERNAL_SERVICE_SECRET=ib-internal-s3cr3t-2026-skillvsync

# Gemini fallback (used when Node key service is unreachable)
GEMINI_API_KEY=AIzaSyCRNiZCkosZ04tzMXEuMo9XaXkn336iWv4
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_TTL=30

WHISPER_MODEL=tiny.en
CHUNK_DURATION_SEC=15
MIN_WORDS_FOR_SCORE=50

SBERT_MODEL=all-MiniLM-L6-v2

# Allow: Node backend (server-to-server), frontend dev servers, tunnels
# Node→ML calls are server-side so no Origin header is sent — but keep all
# client origins here in case the frontend ever calls the ML service directly.
ML_CORS_ORIGINS=http://localhost:4000,http://localhost:5000,http://localhost:5173,http://localhost:5174,http://localhost:3000
