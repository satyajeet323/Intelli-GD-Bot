# ============================================================
# Python Services — Multi-stage image
# Services: FastAPI fluency service (port 8000) + Flask (port 6000)
# Heavy deps: torch, whisper, librosa — cached in separate layer
# ============================================================

# ── Stage 1: heavy ML deps (cached separately) ────────────
FROM python:3.11-slim AS ml-deps
WORKDIR /app

# System deps for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    git \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

# Install heavy ML deps first (changes rarely → better cache)
RUN pip install --no-cache-dir \
    torch==2.2.0 \
    torchaudio==2.2.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install remaining deps
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Stage 2: runtime ───────────────────────────────────────
FROM python:3.11-slim AS runner
WORKDIR /app

# System runtime deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
 && rm -rf /var/lib/apt/lists/*

# Security: non-root user
RUN addgroup --system --gid 1001 pygroup \
 && adduser  --system --uid 1001 pyapp

# Copy installed packages from ml-deps stage
COPY --from=ml-deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=ml-deps /usr/local/bin /usr/local/bin

# Copy application code
COPY --chown=pyapp:pygroup server/*.py ./
COPY --chown=pyapp:pygroup server/filler_crnn_final.pth ./

# Create temp directories
RUN mkdir -p temp temp_audio segments_temp sessions \
 && chown -R pyapp:pygroup temp temp_audio segments_temp sessions

ARG BUILD_SHA=unknown
ARG NODE_ENV=production
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV BUILD_SHA=${BUILD_SHA}

# Health check for FastAPI
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

USER pyapp
EXPOSE 8000 6000

# Start both FastAPI and Flask via supervisor-like script
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port 8000 & python app.py & wait"]
