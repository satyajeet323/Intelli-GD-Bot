# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/gdbot

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Admin JWT ─────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=your-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=8h

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Google Gemini — used by the Python fluency service for topic generation + scoring
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq — used by Node server for AI chat replies
GROQ_API_KEY=your-groq-api-key-here

# ElevenLabs — used for AI Session text-to-speech voice responses
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Optional: override default voice (default: Bella - EXAVITQu4vr4xnSDxMaL)
ELEVENLABS_VOICE_ID=

# ── Python Fluency Service ────────────────────────────────────────────────────
# FastAPI service running main.py (uvicorn main:app --port 8000)
PYTHON_SERVICE_URL=http://localhost:8000

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=300

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── API Key Management ────────────────────────────────────────────────────────
# AES-256-GCM encryption key for stored API keys (use a strong random value)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=your-32-byte-encryption-secret-here

# Shared secret for internal service-to-service calls (Node ↔ Python)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=your-internal-service-secret-here

# URL of the Node.js API (used by Python service to fetch active keys)
NODE_API_URL=http://localhost:4000
